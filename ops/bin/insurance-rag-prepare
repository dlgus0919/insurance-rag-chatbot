#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=insurance-rag-common
source "$SCRIPT_DIR/insurance-rag-common"

BUILD_MISSING=0
FORCE=0

usage() {
  cat <<'EOF'
Usage:
  insurance-rag-prepare [--build-missing] [--force]

Checks and optionally builds runtime artifacts for the FastAPI + SPA app.
Default mode is a strict readiness check.

Options:
  --build-missing  Build missing indexes/databases when source files are present.
  --force          Rebuild supported artifacts even if they exist.
  -h, --help       Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --build-missing)
      BUILD_MISSING=1
      shift
      ;;
    --force)
      FORCE=1
      BUILD_MISSING=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

setup_fastapi_env
mkdir -p "$PROJECT_DIR/logs"

run_step() {
  log "RUN: $*"
  "$@"
}

maybe_build_standard_db() {
  if [[ "$FORCE" == "1" || ! -f data/index/relational/standard_codes.sqlite ]]; then
    [[ "$BUILD_MISSING" == "1" ]] || die "standard code DB is missing. Rerun with --build-missing."
    run_step "$PROJECT_DIR/.venv/bin/python" scripts/build_relational_db.py
  else
    log "OK standard code DB"
  fi
}

maybe_build_default_index() {
  if [[ "$FORCE" == "1" || ! -f data/index/bm25.pkl || ! -f data/index/chroma/chroma.sqlite3 ]]; then
    [[ "$BUILD_MISSING" == "1" ]] || die "default BM25/Chroma index is missing. Rerun with --build-missing."
    require_file "data/processed/chunks.jsonl" "default chunks"
    run_step "$PROJECT_DIR/.venv/bin/python" scripts/ingest.py --stage index --chunks-path data/processed/chunks.jsonl --index-root data/index
  else
    log "OK default BM25/Chroma"
  fi
}

maybe_build_graph() {
  if [[ "$FORCE" == "1" || ! -f "$GRAPH_INDEX_PATH" ]]; then
    [[ "$BUILD_MISSING" == "1" ]] || die "GraphDB is missing. Rerun with --build-missing."
    require_file "data/processed/chunks_v1_v2_combined.jsonl" "combined chunks"
    require_file "data/index/relational/standard_codes.sqlite" "standard code DB"
    run_step "$PROJECT_DIR/.venv/bin/python" scripts/build_graph_index.py --rebuild
  else
    log "OK GraphDB"
  fi
}

maybe_build_ocr_runtime() {
  local needs=0
  for path in \
    data/index_v2_manual/bm25.pkl \
    data/index_v2_manual/chroma/chroma.sqlite3 \
    data/index_v1_v2_combined/bm25.pkl \
    data/index_v1_v2_combined/chroma/chroma.sqlite3 \
    data/mapping/v1_v2_pairs_실무가이드.jsonl \
    data/mapping/v1_v2_pairs_상담사례집.jsonl; do
    [[ -e "$path" ]] || needs=1
  done

  if [[ "$FORCE" == "1" || "$needs" == "1" ]]; then
    [[ "$BUILD_MISSING" == "1" ]] || die "OCR v2/combined runtime artifacts are missing. Rerun with --build-missing."
    run_step bash scripts/prepare_streamlit_runtime.sh --skip-offline-assets --no-verify-load
  else
    log "OK OCR v2/combined indexes and mapping"
  fi
}

maybe_build_standard_db
maybe_build_default_index
maybe_build_ocr_runtime
maybe_build_graph

check_required_runtime_files
log "runtime preparation check complete"
