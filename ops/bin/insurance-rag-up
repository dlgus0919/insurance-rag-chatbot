#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=insurance-rag-common
source "$SCRIPT_DIR/insurance-rag-common"

PROVIDER="$DEFAULT_PROVIDER"
MODEL="$DEFAULT_MODEL"
MODEL_SET=0
REPLACE=0
FOREGROUND=0
SKIP_PREPARE=0
NO_LLM_SWITCH=0
LLAMA_GGUF_OLLAMA_MODEL="${LLAMA_GGUF_OLLAMA_MODEL:-llama-3.3-70b-instruct-q4-k-m}"
LLAMA_GGUF_MODEL_DIR="${LLAMA_GGUF_MODEL_DIR:-$AI_OPS_ROOT/llm/models/$LLAMA_GGUF_OLLAMA_MODEL}"
LLAMA_GGUF_FILE="${LLAMA_GGUF_FILE:-$LLAMA_GGUF_MODEL_DIR/Llama-3.3-70B-Instruct-Q4_K_M.gguf}"
LLAMA_GGUF_MODELFILE="${LLAMA_GGUF_MODELFILE:-$PROJECT_DIR/ops/ollama/$LLAMA_GGUF_OLLAMA_MODEL.Modelfile}"

usage() {
  cat <<'EOF'
Usage:
  insurance-rag-up [options]

Starts the production FastAPI + SPA app for DGX local use.
Default target: SGLang qwen3-next-80b-a3b-instruct-fp8 + http://127.0.0.1:18080

Options:
  --provider <sglang|vllm|trtllm|ollama>
                                  LLM provider. Default: sglang
  --model <model-id>               Model id. Default: qwen3-next-80b-a3b-instruct-fp8
  --port <port>                    FastAPI app port. Default: 18080
  --host <host>                    FastAPI bind host. Default: 127.0.0.1
  --replace                        Stop existing app session/listener first.
  --skip-prepare                   Skip runtime artifact readiness check.
  --no-llm-switch                  Do not call provider switch wrappers.
  --foreground                     Run uvicorn in the current shell, not tmux.
  -h, --help                       Show this help.
EOF
}

ollama_model_installed() {
  local model="$1"
  command -v ollama >/dev/null 2>&1 || return 1
  OLLAMA_HOST="$OLLAMA_HOST" ollama list 2>/dev/null \
    | awk 'NR > 1 {print $1}' \
    | awk -v model="$model" '$1 == model || $1 == model ":latest" {found = 1} END {exit !found}'
}

ensure_ollama_gguf_model() {
  local model="$1"
  [[ "$model" == "$LLAMA_GGUF_OLLAMA_MODEL" || "$model" == "$LLAMA_GGUF_OLLAMA_MODEL:latest" ]] || return 0
  require_file "$LLAMA_GGUF_FILE" "Llama 3.3 70B GGUF model"
  require_file "$LLAMA_GGUF_MODELFILE" "Llama 3.3 Ollama Modelfile"
  command -v ollama >/dev/null 2>&1 || die "ollama command is required for $model"

  if ollama_model_installed "$LLAMA_GGUF_OLLAMA_MODEL"; then
    log "Ollama model already installed: $LLAMA_GGUF_OLLAMA_MODEL"
    return 0
  fi

  log "creating Ollama model from GGUF: $LLAMA_GGUF_OLLAMA_MODEL"
  OLLAMA_HOST="$OLLAMA_HOST" ollama create "$LLAMA_GGUF_OLLAMA_MODEL" -f "$LLAMA_GGUF_MODELFILE"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --provider)
      PROVIDER="${2:?--provider requires a value}"
      shift 2
      ;;
    --model)
      MODEL="${2:?--model requires a value}"
      MODEL_SET=1
      shift 2
      ;;
    --port)
      export INSURANCE_RAG_APP_PORT="${2:?--port requires a value}"
      APP_PORT="$INSURANCE_RAG_APP_PORT"
      shift 2
      ;;
    --host)
      export INSURANCE_RAG_APP_HOST="${2:?--host requires a value}"
      APP_HOST="$INSURANCE_RAG_APP_HOST"
      shift 2
      ;;
    --replace)
      REPLACE=1
      shift
      ;;
    --skip-prepare)
      SKIP_PREPARE=1
      shift
      ;;
    --no-llm-switch)
      NO_LLM_SWITCH=1
      shift
      ;;
    --foreground)
      FOREGROUND=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

case "$PROVIDER" in
  sglang|vllm|trtllm|ollama) ;;
  *) die "unsupported provider: $PROVIDER" ;;
esac

if [[ "$MODEL_SET" == "0" ]]; then
  case "$PROVIDER" in
    sglang)
      MODEL="${INSURANCE_RAG_MODEL:-qwen3-next-80b-a3b-instruct-fp8}"
      ;;
    vllm)
      MODEL="${INSURANCE_RAG_MODEL:-gemma-4-31b-it-nvfp4}"
      ;;
    trtllm)
      die "TensorRT-LLM gpt-oss-120b is unsupported on this DGX Spark project state; use sglang or vllm."
      ;;
    ollama)
      MODEL="${INSURANCE_RAG_MODEL:-exaone3.5:7.8b}"
      ;;
  esac
fi

if [[ "$PROVIDER" == "trtllm" ]]; then
  die "TensorRT-LLM runtime is retained only for historical diagnostics and is not an app startup provider."
fi

if [[ "$FOREGROUND" == "1" ]]; then
  run_uvicorn_foreground
fi

setup_fastapi_env

if [[ "$SKIP_PREPARE" != "1" ]]; then
  "$SCRIPT_DIR/insurance-rag-prepare"
fi

if [[ "$NO_LLM_SWITCH" != "1" ]]; then
  case "$PROVIDER" in
    sglang)
      require_file "$SGLANG_SWITCH_SCRIPT" "SGLang switch script"
      log "switching SGLang model: $MODEL"
      "$SGLANG_SWITCH_SCRIPT" "$MODEL"
      export SGLANG_DEFAULT_MODEL="$MODEL"
      export SGLANG_CANDIDATE_MODELS="$MODEL"
      ;;
    vllm)
      require_file "$VLLM_SWITCH_SCRIPT" "vLLM switch script"
      log "switching vLLM model: $MODEL"
      "$VLLM_SWITCH_SCRIPT" "$MODEL"
      export VLLM_DEFAULT_MODEL="$MODEL"
      export VLLM_CANDIDATE_MODELS="$MODEL"
      ;;
    trtllm)
      require_file "$TRTLLM_SWITCH_SCRIPT" "TensorRT-LLM switch script"
      log "switching TensorRT-LLM model: $MODEL"
      "$TRTLLM_SWITCH_SCRIPT" "$MODEL"
      export TRTLLM_DEFAULT_MODEL="$MODEL"
      export TRTLLM_CANDIDATE_MODELS="$MODEL"
      export TRTLLM_STRICT_AVAILABLE_MODELS=true
      ;;
    ollama)
      ensure_ollama_gguf_model "$MODEL"
      log "using Ollama model without switch wrapper: $MODEL"
      export OLLAMA_MODEL="$MODEL"
      export OLLAMA_CANDIDATE_MODELS="$MODEL"
      export SGLANG_STRICT_AVAILABLE_MODELS=false
      export VLLM_STRICT_AVAILABLE_MODELS=false
      ;;
  esac
fi

if tmux has-session -t "$APP_SESSION" 2>/dev/null; then
  if [[ "$REPLACE" == "1" ]]; then
    log "stopping existing tmux session: $APP_SESSION"
    tmux kill-session -t "$APP_SESSION"
    wait_for_port_free 20 || warn "port $APP_PORT is still busy after stopping tmux session"
  else
    if api_health_ok; then
      log "app is already running: http://$APP_HOST:$APP_PORT"
      exit 0
    fi
    die "tmux session already exists but app health failed. Rerun with --replace."
  fi
fi

if port_is_listening; then
  if [[ "$REPLACE" == "1" ]]; then
    mapfile -t pids < <(port_pids)
    if [[ "${#pids[@]}" -eq 0 ]]; then
      warn "port $APP_PORT is busy but listener PID could not be resolved; waiting for graceful release"
      if wait_for_port_free 30; then
        log "port $APP_PORT released"
      else
        die "port $APP_PORT is in use but listener PID could not be resolved"
      fi
    else
      for pid in "${pids[@]}"; do
        log "stopping listener PID $pid on port $APP_PORT"
        kill "$pid"
      done
      wait_for_port_free 20 || warn "port $APP_PORT is still busy after stopping listener PID(s)"
    fi
  else
    die "port $APP_PORT is already in use. Rerun with --replace or --port <other>."
  fi
fi

mkdir -p "$APP_LOG_DIR"
log_file="$APP_LOG_DIR/fastapi_$(date +%Y%m%d_%H%M%S).log"
log "starting app tmux session: $APP_SESSION"

tmux new-session -d -s "$APP_SESSION" \
  "INSURANCE_RAG_PROJECT_DIR='$PROJECT_DIR' AI_OPS_ROOT='$AI_OPS_ROOT' INSURANCE_RAG_APP_HOST='$APP_HOST' INSURANCE_RAG_APP_PORT='$APP_PORT' INSURANCE_RAG_PROVIDER='$PROVIDER' INSURANCE_RAG_MODEL='$MODEL' '$SCRIPT_DIR/insurance-rag-up' --foreground --skip-prepare --no-llm-switch 2>&1 | tee '$log_file'"

if wait_for_api 120; then
  log "app ready: http://$APP_HOST:$APP_PORT"
  cat <<EOF

Mac tunnel:
  ssh -N -L $APP_PORT:127.0.0.1:$APP_PORT ai-hang@100.88.5.57

Browser:
  http://localhost:$APP_PORT

Status:
  $SCRIPT_DIR/insurance-rag-status

Log:
  $log_file
EOF
else
  warn "app did not become healthy within timeout"
  warn "check log: $log_file"
  exit 1
fi
