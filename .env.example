EMBEDDING_MODEL=BAAI/bge-m3
HF_MODEL_DOWNLOAD=false                    # true이면 Streamlit Cloud에서 HuggingFace 모델 다운로드 허용
OLLAMA_HOST=http://localhost:11434
# LLM 모델 설정 (성능 순)
# OLLAMA_MODEL=qwen2.5:7b-instruct         # 추천: 범용 7B
# OLLAMA_MODEL=exaone3.5:7.8b-instruct     # 추천: 한국어 특화 7.8B
# OLLAMA_MODEL=qwen2.5:14b-instruct        # 고성능: 14B (메모리 10GB+)
OLLAMA_MODEL=gemma3:4b                     # 기본값 (테스트 환경 호환)
OLLAMA_NUM_CTX=16384
RERANKER_ENABLED=true
LOG_DIR=logs                               # 감사 로그 저장 디렉터리
# APP_PASSWORD는 M15부터 사용하지 않습니다. `python scripts/manage_users.py init`으로 계정을 생성하세요.

# === OpenAI (선택) ===
# OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_DEFAULT_MODEL=gpt-5.2-chat-latest
OPENAI_MAX_TOKENS=1500
OPENAI_CANDIDATE_MODELS=gpt-5.5,gpt-5.2-chat-latest,gpt-5.4-mini,gpt-5-mini
ALLOW_OLLAMA=true
CLOUD_DEPLOY=false
# INDEX_RELEASE_URL=https://github.com/.../releases/download/.../assets.zip
# USERS_JSON={"version":1,"users":[]}
# USERS_JSON_PATH=users.json
TOP_K_DENSE=12
TOP_K_BM25=12
TOP_K_FINAL=8
RRF_K=60
CHUNK_TARGET_CHARS=800
CHUNK_OVERLAP_CHARS=100
