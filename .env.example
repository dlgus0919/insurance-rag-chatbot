OFFLINE_MODE=true                       # DGX 기본값: 외부 LLM/모델 다운로드를 숨기고 로컬 경로만 사용
EMBEDDING_MODEL=/srv/ai-ops/models/embedding/bge-m3
HF_MODEL_DOWNLOAD=false                    # true이면 Streamlit Cloud에서 HuggingFace 모델 다운로드 허용
RERANKER_MODEL=/srv/ai-ops/models/reranker/bge-reranker-v2-m3
RERANKER_ENABLED=true
LOG_DIR=logs                               # 감사 로그 저장 디렉터리
# 선택 OCR/OpenAI/Ollama 실행값은 표준 .env에 저장하지 않고 해당 명령에만 주입합니다.

# === SGLang local OpenAI-compatible provider ===
SGLANG_BASE_URL=http://127.0.0.1:30000/v1
SGLANG_API_KEY=EMPTY
SGLANG_DEFAULT_MODEL=qwen3-next-80b-a3b-instruct-fp8
SGLANG_REASONING_EFFORT=low
SGLANG_REASONING_MAX_TOKENS=10240
SGLANG_CANDIDATE_MODELS=qwen3-next-80b-a3b-instruct-fp8,qwen3-30b-a3b-instruct-2507-fp8,gpt-oss-20b
SGLANG_DISABLED_MODELS=gemma-4-26b-a4b-nvfp4,nemotron-3-nano-30b-a3b-nvfp4,gpt-oss-120b,qwen3-next-80b-a3b-thinking-fp8
SGLANG_MODEL_ENDPOINTS=
SGLANG_STRICT_AVAILABLE_MODELS=true
SGLANG_ENABLE_APP_SWITCH=true
SGLANG_SWITCH_SCRIPT=/srv/ai-ops/bin/switch-sglang-model
SGLANG_SWITCH_TIMEOUT=900
VLLM_DEFAULT_MODEL=gemma-4-31b-it-nvfp4
VLLM_CANDIDATE_MODELS=gemma-4-31b-it-nvfp4
VLLM_DISABLED_MODELS=gemma-4-26b-a4b-nvfp4,nemotron-3-nano-30b-a3b-nvfp4,exaone-4.0-32b-awq
# INDEX_RELEASE_URL=https://github.com/.../releases/download/.../assets.zip
# USERS_JSON={"version":1,"users":[]}
# USERS_JSON_PATH=users.json
TOP_K_DENSE=12
TOP_K_BM25=12
TOP_K_FINAL=8
RRF_K=60
AUTO_RAG_PARAMS_MODE=apply
AUTO_RAG_TOPK_STRATEGY=reranker_threshold
AUTO_RAG_PROFILE_POLICY_PATH=config/auto_rag_profile_policy.json
AUTO_RAG_TEMPERATURE_POLICY_PATH=config/auto_rag_temperature_policy.json
CLAUSE_DETAIL_POLICY_PATH=config/clause_detail_lookup_policy.json
CHUNK_TARGET_CHARS=800
CHUNK_OVERLAP_CHARS=100
